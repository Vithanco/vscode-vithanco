{
  "name": "vithanco",
  "displayName": "Vithanco",
  "description": "Render Vithanco Graph Language (VGL) diagrams inside VS Code's Markdown preview.",
  "version": "1.0.5",
  "publisher": "vithanco",
  "license": "MIT",
  "author": "Klaus Kneupner",
  "homepage": "https://vithanco.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vithanco/VGraph"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "vgl",
    "vithanco",
    "diagram",
    "ibis",
    "concept-map",
    "timeline"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./styles.css"
    ],
    "languages": [
      {
        "id": "vgl",
        "aliases": [
          "VGL",
          "Vithanco Graph Language"
        ],
        "extensions": [
          ".vgl"
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "watch": "node esbuild.config.mjs",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.3.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.0.0"
  }
}
